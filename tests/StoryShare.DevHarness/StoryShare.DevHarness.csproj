<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders every card layout to PNG and exercises the share-token signing, without
    needing a running Jellyfin server. Run it after touching the renderer;
    the README has the command.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AssemblyName>StoryShare.DevHarness</AssemblyName>
    <RootNamespace>RenderTest</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.StoryShare\Jellyfin.Plugin.StoryShare.csproj" />

    <!-- The plugin excludes these at runtime because the server supplies them;
         the harness has no server, so it needs the real assemblies. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.11" />
  </ItemGroup>

</Project>

